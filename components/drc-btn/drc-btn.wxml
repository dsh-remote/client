<!--
  drc-btn —— 主按钮 / 危险按钮（阶段 C2）。用法：

    <drc-btn text="允许" loading="{{busy}}" bind:tap="onApprove" />
    <drc-btn text="解除配对" variant="danger" block bind:tap="onUnpair" />

  ⚠️ `variant="danger"` 是**描边红**，不是**填充红**。原因写在 wxss 里，一句话版本：
     深色下"白字压在红底上"用现有的修正色阶过不了 4.5，而描边红用的是
     `--drc-fg-danger`（那个色是**逐主题修过**的，对比度闸验过）。
  ⚠️ loading 与 disabled 都在组件内部拦 tap：调用方不用自己判。
-->
<view
  class="drc-btn drc-btn--{{cls}} drc-btn--{{size}} {{block ? 'is-block' : ''}} {{disabled ? 'is-disabled' : ''}}"
  hover-class="{{loading || disabled ? '' : 'drc-btn-pressed'}}"
  hover-stay-time="80"
  aria-role="button"
  aria-disabled="{{disabled || loading}}"
  bindtap="onTap">
  <!--
    loading 时**不显示文字**：文字 + 转圈会互相挤，按钮宽度跳一下。
    这是"金额已提交"这类按钮最常见的抖动来源。
  -->
  <view wx:if="{{loading}}" class="drc-btn-spin" aria-hidden="true"></view>
  <text wx:else class="drc-btn-text">{{text}}</text>
</view>
