{
  "name": "@dsh-remote/client",
  "version": "2.0.21",
  "private": true,
  "description": "DSH Remote Control 的微信小程序客户端：扫码配对主机，发指令、看流式输出、回答审批。",
  "license": "MIT",
  "author": "dsh-remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-remote/dsh-remote-client.git"
  },
  "homepage": "https://github.com/dsh-remote/dsh-remote-client#readme",
  "bugs": {
    "url": "https://github.com/dsh-remote/dsh-remote-client/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "remote-control",
    "relay",
    "websocket",
    "wechat",
    "miniprogram",
    "e2e-encryption"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run verify && npm run md && npm run scroll && npm run theme:check && npm run contrast",
    "verify": "node scripts/verify-miniprogram.mjs",
    "md": "node --test scripts/check-markdown.mjs",
    "theme": "node scripts/gen-mp-theme.mjs",
    "theme:check": "node scripts/gen-mp-theme.mjs --check",
    "contrast": "node scripts/check-mp-contrast.mjs",
    "scroll": "node --test scripts/check-scroll.mjs"
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.10.0",
    "js-base64": "^3.7.7"
  }
}
