/* sessions 页：组件之外只剩少量布局。
   颜色一律走 TDesign 变量：主题按 prefers-color-scheme 自动切换，
   写死 #fff 的话在深色模式手机上会变成白底白字。 */

/* ── 未配对：扫码入口 + 折叠的手动输入 ──────────────────────────────
   原来这里还有一张三步说明卡（hero-steps）。删掉 pair 页之后，表单已经没了，
   那三步是在给一张已经不存在的表单写说明书 —— 留着只是占版面。 */
.hero {
  padding-top: 56rpx;
}

.hero-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
  background: var(--td-brand-color, #0052d9);
  color: var(--td-text-color-anti, #ffffff);
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 首屏那枚徽标是整页唯一的品牌展示面 —— **两个主题都给**渐变 + 投影。
   （2026-10-09 只给深色做过；2026-10-10 扩到共用：浅色是**默认**主题，
   只给深色加等于大多数用户看不到这个设计。）
   ⚠️ `background`（那一个变量）保持不动、渐变叠在它上面：对比度闸读的是
   `background`，它看到的必须是真的底色。渐变两端的白字对比度在
   gen-mp-theme.mjs 的 `DARK_PAINT` / `LIGHT_PAINT` 注释里各自手工守着。 */
.hero-mark {
  background-image: var(--td-brand-gradient);
  /* 浅色：投影用**中性冷灰**而不是品牌色 —— 品牌色投影在浅底上会泛出一圈紫，
     看着像没对准焦。深色那边反过来（见下）：深底上中性阴影根本看不见。 */
  box-shadow: 0 10rpx 26rpx 0 rgba(29, 42, 74, 0.20);
}

.theme-dark .hero-mark {
  box-shadow:
    0 14rpx 36rpx 0 rgba(63, 91, 246, 0.32),
    inset 0 2rpx 0rpx 0 rgba(255, 255, 255, 0.22);
}

.hero-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
}

.hero-desc {
  margin: 16rpx 8rpx 8rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

.hero-note {
  margin-top: 20rpx;
  text-align: center;
}

/* 演示入口：次级文字链，不做成按钮 ——
   它是"没有主机时也能看看"的退路，不是与主按钮竞争的第二条主路径。
   但字号与颜色要与 .manual-toggle 同级（可见、不那么抢），
   否则"藏起来的演示等于没有演示"。 */
.hero-demo {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

/* ── 演示横幅 ─────────────────────────────────────────────────────
   常驻在列表最上方，**不随任何状态消失**：它回答的是"这些是不是真数据"，
   而那个问题在每一帧都存在。用中性灰而不是警告色——演示不是错误状态，
   但也不能用品牌色（那会读成"这是推荐的操作"）。 */
.demo-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.demo-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--td-text-color-placeholder, #9aa0a6);
}

.demo-text {
  min-width: 0;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

/* 手动输入的开关。纯 CSS 三角，展开时翻转 —— 比两个纯文字更能提示可折叠 */
.manual-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--td-brand-color-on-tint, #0052d9);
}

.caret {
  width: 0;
  height: 0;
  margin-right: 12rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--td-brand-color, #0052d9);
  transition: transform 0.2s ease;
}

.caret.up {
  transform: rotate(180deg);
}

.manual {
  margin-top: 8rpx;
  padding: 28rpx;
}

.manual-label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #5c6470);
  margin-bottom: 12rpx;
}

.manual-label + .field-box,
.manual-label + .code-box {
  margin-bottom: 28rpx;
}

/* 输入行：浅底嵌入卡片，看上去就是个可输入的框。
   input 必须显式 height：靠上下 padding 撑高会把文字垂直裁掉（真机实证）。 */
.field-box {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 16rpx 0 24rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.field-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  color: var(--td-text-color-primary, #1f2329);
}

.field-ph {
  font-size: 28rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.field-clear {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--td-bg-color-component, #e7e7e7);
  color: var(--td-text-color-placeholder, #a0a6b0);
  font-size: 24rpx;
}

/* 读剪贴板：不必让用户长按输入框去粘，点一下就行 */
.field-paste {
  flex: 0 0 auto;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-container, #ffffff);
  color: var(--td-brand-color-on-tint, #0052d9);
  font-size: 24rpx;
}

/* 6 位配对码：大号居中，配一排进度点 */
.code-box {
  padding: 16rpx 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.code-input {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 56rpx;
  letter-spacing: 20rpx;
  /* letter-spacing 会在最后一个字符后面也留一格，往左挪一点视觉才居中 */
  padding-left: 20rpx;
  color: var(--td-text-color-primary, #1f2329);
}

.code-ph {
  font-size: 40rpx;
  letter-spacing: 16rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.code-scale {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.code-pip {
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin: 0 6rpx;
  background: var(--td-component-border, #dcdcdc);
}

.code-pip.on {
  background: var(--td-brand-color, #0052d9);
}

.foot-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

/* 环境缺能力的警示卡 */
.warn {
  background: var(--td-error-color-1, #fff0ed);
  border-color: var(--td-error-color-3, #ffb9b0);
  padding: 24rpx;
  margin-top: 24rpx;
}

.warn-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: var(--td-error-color-6, #d54941);
}

.warn-text {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--td-text-color-primary, #1f2329);
}

.btn-gap {
  margin-top: 32rpx;
}

/* ── 主机卡 ─────────────────────────────────────────────────────── */
.host {
  padding: 28rpx;
}

.host-head {
  display: flex;
  align-items: center;
}

/* 颜色来自 app.wxss 的 .dot；这里只管间距 */
.host-head .dot {
  margin-right: 14rpx;
}

.host-name {
  flex: 1 1 auto;
  font-size: 32rpx;
  font-weight: 500;
}

/* 主机卡里最后一行：下边距交给 .host 的padding，这里保持 0 */
.host-sub {
  margin: 12rpx 0 0 30rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

/* 主机卡里的「解除配对」（2026-10-04 从页面底部挪进来）。
   卡片回答的是"这台主机通不通"，"不要这台了"就属于这张卡——
   原来沉在页面最底部，旁边还挨着一颗多余的入口（已删）。 */
.host-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--td-component-border, #dcdcdc);
}

/* 破坏性动作但**不当主角**：不用实心红（这一页的主动作是新建会话，
   实心红会抢），浅红底 + 红字，扫一眼知道"这个会断"就够了。
   颜色与 app.wxss 里那颗 error 角标同一对 token（对比度检查认这两条）。 */
.host-danger {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--td-error-color-1, #fff0ed);
  color: var(--td-error-color-6, #d54941);
}

/* ── 会话列表 ───────────────────────────────────────────────────── */
.section-title {
  display: flex;
  align-items: center;
}

.section-count {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-placeholder, #a0a6b0);
}

/* 「＋ 新建会话」。它是这一页的主动作，但**不做成实心大按钮** ——
   一屏里已经有一张主机卡，再放一个实心主按钮就会和它抢注意力（skill 坑位 8），
   所以用 tonal（浅品牌底 + 品牌字）这一档。 */
.section-action {
  flex: 0 0 auto;
  margin-left: auto;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--td-brand-color-1, #f2f3ff);
  color: var(--td-brand-color-on-tint, #0052d9);
}

/* 没连上时置灰：**能看见、能点，点了会说为什么**。
   直接藏起来看着更干净，但用户不知道去哪找，也不知道为什么没有。 */
.section-action.off {
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.section-action.busy {
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-secondary, #666);
}

/* 转圈：CSS 画，不引图标字体（图标字体走远程 CDN，拉不到就是空白方块） */
.new-spin {
  width: 20rpx;
  height: 20rpx;
  margin-right: 10rpx;
  border: 3rpx solid var(--td-component-border, #dcdcdc);
  border-top-color: var(--td-brand-color, #0052d9);
  border-radius: 50%;
  animation: new-spin 0.8s linear infinite;
}

@keyframes new-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 归档会话被过滤掉时的一句说明（居中、弱化，别抢会话行的注意力） */

.sess {
  display: flex;
  /* flex-start：两行文字比 64rpx 的色条高，center 会让色条悬在中间。 */
  align-items: flex-start;
  padding: 24rpx 24rpx 24rpx 0;
}

/* 左侧状态色条：一整张卡里的一行，所以只需要对着这一行的高度。
   通高（stretch）是 10-05 白天"一会话一卡"那版的产物——那张每行自成一个
   卡片，色条要当卡片的完整边。现在回到一张大卡，色条回到 64rpx。
   圆角只给右侧：左边被父级 overflow:hidden 切出卡片的圆角。 */
.sess-bar {
  flex: 0 0 auto;
  width: 8rpx;
  height: 64rpx;
  border-radius: 0 8rpx 8rpx 0;
}

/* 行与行之间的细线。1.1.16 曾把它删掉改成一会话一卡，
   用户明确说"还是原来的样式（不要卡片）"，所以它回来了。
   左边留 30rpx 缩进：贴着色条太挤，也跟卡片的圆角打架。 */
.sess-line {
  height: 2rpx;
  margin-left: 30rpx;
  background: var(--td-component-border, #dcdcdc);
}

/* 左侧色条的三个颜色档，由 `item.badgeTheme` 选（js 里 badgeFor 只产出
   primary/default，warning 是**留着一档**：主机侧补齐 awaiting-* 之后
   待审批/待回答要用它，而"有的档有颜色、有的档没有"会让色条在某个状态下
   变成空白 —— 那看起来像布局坏了。留着这一行零成本，删掉反而会埋一个坑。 */
.sess-bar.primary { background: var(--td-brand-color, #0052d9); }
.sess-bar.warning { background: var(--td-warning-color, #e37318); }
.sess-bar.default { background: transparent; }

.sess-main {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 22rpx;
}

/* 标题：第一行里占比最大的那块。flex:1 让它把徽挤到右边后剩下的全占，
   min-width:0 是 ellipsis 能生效的前提（flex 子项默认不会窄于内容宽）。 */
.sess-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  line-height: 42rpx;
}

/* 第一行：标题 + 状态徽标。两者都是"这条现在怎么了"，所以一行。 */
.sess-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 第二行：项目名 + 时间。 */
.sess-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  min-width: 0;
}

/* 项目名：品牌色圆点 + 24rpx 深灰文字（2026-10-05 用户：去掉路径只保留项目，
   强化样式，"不一定要用标签形式"，重新设计）。
   它改过四轮，都记在这里：
   - 10-04         标题右边的品牌蓝 chip   -> 抢标题宽度
   - 10-05 上午    单独一行的 chip        -> 行高撑成三行
   - 10-05 下午    右上角纯文字           -> 用户：一点样式都没有
   - 10-05 下午    第二行描边胶囊+全路径   -> 用户：去掉路径、强化、别用标签形
   这一轮的强化在**字号和字色**，不再靠描边/底色：
   - 20rpx -> 24rpx：跟时间（20rpx）拉开一档，仍小于标题（30rpx）。
   - placeholder(#a0a6b0) -> text-color-secondary(#5c6470)：深一档，
     读得清，但不去抢标题的近黑。
   - 左侧 12rpx 实心圆点用品牌色，给"这是哪一间屋子"一个视觉锚点。
     圆点是 CSS 画的（border-radius + background），不用图标字体——
     这一页一个图标都没有，真机缺字形时会变成空白方块。
   ⚠️ 不再用胶囊的原因：胶囊把项目名关在方块里，字号顶到 20rpx 就挤。
      路径去掉后这一行只剩它和时间，横向空间够，文字才吃得下 24rpx。 */
.sess-project {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  min-width: 0;
}

.sess-project-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--td-brand-color, #0052d9);
}

/* 名字本身：ellipsis 三件套 + min-width:0 都要，否则长项目名会把时间戳顶掉。
   （.ellipsis 里已含 min-width:0，这里再写一遍是因为 <text> 作为 flex 子项时，
    WebKit 某些版本对父级继承来的 min-width 处理不一致——显式写死最稳。） */
.sess-project-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

/* 时间：第二行最右。
   **margin-left:auto 是关键**：flex 里 auto 外边距会吸走全部剩余空间，
   把这一项顶到行尾。
   ⚠️ 全路径（.sess-sub）在的时候靠它的 flex:1 撑开；路径被去掉之后（2026-10-05
      用户要求），第二行只剩项目名和时间，再没有 flex:1 的项，
      时间就会紧贴在项目名后面而不是贴右边——那正是本次要修的点。
   padding-left:20rpx 保证空间被挤满时两者仍有余距（auto margin 会缩到 0，
   但 padding 不会）。 */
.sess-time {
  flex: 0 0 auto;
  margin-left: auto;
  padding-left: 20rpx;
  font-size: 20rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

/* 状态徽标：第一行最右。实心填色。
   flex:0 0 auto 保证它不被标题压扁（时间戳也同理）。
   这套规则整块在 1.1.18 丢过一次：那次删 .sess-tag/.sess-sub 时把这个块
   一起吃掉了，只剩 .sess-badge.primary .pulse 一条。
   后果是徽标退回普通块级盒子——里面的 .pulse 没有 flex 容器可待，独占一行，
   "运行中"三个字被挤到下一行，看着就是点跑到文字上面去了。
   判据（mp-sessions-list）现在钉住这套规则必须在，防止再被顺手删掉。 */
.sess-badge {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-secondary, #5c6470);
}

/* 徽标的三种配色档，由 `item.badgeTheme` 选（wxml 绑的是变量，不是写死的类名）。
   js 里 badgeFor 现在只产出 primary/default；warning / success 留着是因为
   ① 主机侧的 awaiting-* 一旦补齐，待审批/待回答要用 warning；
   ② 每一档都要有配色，缺一档就会出现"某条会话的徽标没有底色"（看起来像渲染坏了）；
   ③ e2e 有一条判据按名字锁着 `.sess-badge.warning`（删掉它那条会红）。
   三档都以 `--td-*-color-1` 为底、`-6` 为字：两端主题都过对比度（见 check-mp-contrast）。 */
.sess-badge.primary {
  background: var(--td-brand-color-1, #f2f3ff);
  color: var(--td-brand-color-on-tint, #0052d9);
}

.sess-badge.warning {
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--td-warning-color-6, #be5a00);
}

.sess-badge.success {
  background: var(--td-success-color-1, #e3f6e8);
  color: var(--td-success-color-6, #029e42);
}

/* ── 右下角一列悬浮键：分享 + 主题（2026-10-10）─────────────────────────
   用户要求：「在 home 和 sessions 都能切换，统一位置」。

   改之前主题开关是"已配对"那一支 footer 里的一个胶囊 —— 而未配对那一屏（扫码首页）
   **根本没有 footer** ⇒ 那一屏切不了主题。所以换成**一列固定悬浮键**：
   两个元素、一个位置、两屏都在（wxml 里它们已经在两个 `wx:if` 分支之外）。

   位置选**右下角**而不是顶栏：顶栏是系统导航栏（原生组件，不吃 CSS），
   自己再画一条会多占一行；右下角是拇指区，也是这一页历史上主题开关待过的地方。

   ⚠️ `width/height` 给到 **88rpx = 44px**：判据 ⑪ 要求"绑了手势且写了固定宽高的元素
   最小边不小于 88rpx"。两个键都是固定尺寸，所以必须过线 —— 不能靠 padding 撑。
   ⚠️ 五类几何声明一律走 `--drc-*` token（`check-mp-tokens` 的棘轮卡着裸值）；
   `width/height/right/bottom` 不在那份名单里。 */
.fab-stack {
  position: fixed;
  right: var(--drc-space-3);
  bottom: calc(var(--drc-space-3) + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: var(--drc-space-2);
}

/* 两个键共用同一副"壳"：同尺寸、同圆角、同底色 —— 它们是同一层的次要动作，
   长得不一样会让人以为其中一个更重要。 */
.theme-fab,
.share-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--drc-radius-pill);
  background: var(--td-bg-color-container);
  border: 2rpx solid var(--td-component-border);
  box-shadow: var(--td-shadow-1);
}

/* ⚠️ 小程序的原生 `<button>` 自带一套样式（灰底、圆角、`::after` 那圈边框），
   不复位的话它会把上面那副壳盖掉 —— 表现为"分享键长得跟主题键不一样"。
   这几条**不是**可选的润色，是让 `<button>` 退化成普通盒子的必要复位。
   （`<button>` 是必需的：`open-type="share"` 只在这个标签上生效。） */
.share-fab {
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: 0;
  overflow: visible;
}

.share-fab::after {
  border: none;
}

/* ── 图标：**SVG 形状 + CSS mask** ─────────────────────────────────────
   形状是矢量的（月牙 / 太阳 / 分享），颜色仍然是主题 token ——
   `background-color` 决定颜色、`mask` 决定形状，所以**不需要**为两套主题
   各烘一份"带色 SVG"（那种做法会把色值写死进 wxss，改配色时没人会想起来改它）。

   ⚠️ 为什么不用图标字体：TDesign 的 t-icon 走远程 CDN，拉不到就是一堆空白方块
   且**不报错**。
   ⚠️ `mask` 在本项目的目标渲染器里**有先例**：TDesign 的 loading 组件就用
   `-webkit-mask` 画环形缺口（`miniprogram_npm/.../loading.wxss`），所以不是新引入的能力。
   标准属性与 `-webkit-` 前缀都写一份（微信 webview 两个都认，写全了换渲染器也不翻）。 */
.theme-icon,
.share-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: var(--td-text-color-secondary);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

/* 月牙（Feather 的 moon）：当前是浅色 ⇒ 点了变深。
   ⚠️ SVG 里的 `stroke='#fff'` **只是为了让 mask 取到不透明像素** ——
   它不决定显示颜色（颜色来自上面的 `background-color`），所以不是写死的色值。 */
.theme-icon.moon {
  -webkit-mask-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjZmZmJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PHBhdGggZD0nTTIxIDEyLjc5QTkgOSAwIDEgMSAxMS4yMSAzIDcgNyAwIDAgMCAyMSAxMi43OXonLz48L3N2Zz4=');
  mask-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjZmZmJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PHBhdGggZD0nTTIxIDEyLjc5QTkgOSAwIDEgMSAxMS4yMSAzIDcgNyAwIDAgMCAyMSAxMi43OXonLz48L3N2Zz4=');
}

/* 太阳（Feather 的 sun）：当前是深色 ⇒ 点了变浅。 */
.theme-icon.sun {
  -webkit-mask-image: url('data:image/svg+xml;base64,');
  mask-image: url('data:image/svg+xml;base64,');
}

/* 分享（Feather 的 share-2）：三个节点 + 两条连线。 */
.share-icon {
  -webkit-mask-image: url('data:image/svg+xml;base64,');
  mask-image: url('data:image/svg+xml;base64,');
}

/* 归档计数行（2026-10-08：归档区收回成"只报数量"）。
   刻意做得比会话行更轻：它是脚注，不是入口 —— 不给按压反馈，也不做可点的东西。 */
.archived-note {
  padding: var(--drc-space-2) var(--drc-space-3);
  text-align: center;
  color: var(--td-text-color-placeholder);
  font-size: var(--drc-font-sm);
}
