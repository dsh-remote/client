/* 全局样式：TDesign 设计变量 + 页面级骨架（组件内部样式由 TDesign 提供） */
@import './miniprogram_npm/tdesign-miniprogram/common/style/theme/_index.wxss';
/* 主题变量表。**三份的 import 顺序不能换**，理由逐条：
   ① _index.wxss —— TDesign 原件，深浅两套都包在 @media (prefers-color-scheme) 里。
   ② theme/light.wxss —— 浅色（**默认态**）。把浅色变量从 @media 里解放出来、
      无条件生效，选择器与 TDesign 同为 .page,page，靠「同特异性下源码顺序靠后的胜出」
      压掉 _index 里的深色分支。所以**系统是深色也是白底深字**。
   ③ theme/dark.wxss —— 深色。选择器是 .theme-dark，挂在**页面根容器**的 class 上。
      必须在 light 之后：light 写在 page 上会向下继承，本表靠顺序压掉它。
   ②③ 两份都是 scripts/gen-mp-theme.mjs 的生成物，不要手改。 */
@import './theme/light.wxss';
@import './theme/dark.wxss';

page {
  background: var(--td-bg-color-page, #f3f3f3);
  color: var(--td-text-color-primary, #1f2329);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  /* 页面自身高度由系统给出：用 % 而不是 100vh，否则 iOS 上会把导航栏高度
     也算进去，底部输入区被顶出屏幕（移动端「排版错乱」最常见的成因）。 */
  height: 100%;
  -webkit-text-size-adjust: 100%;
}

view, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

.page-pad {
  /* 底部留白要给主题开关那颗**固定悬浮键**让位（2026-10-10）：
     它 88rpx 高、离底 24rpx ⇒ 占掉底部 112rpx。不留够的话，
     列表最后一行与「已归档 N 条」会被压在它下面，而悬浮键是 fixed、
     不参与文档流 —— 用户滚到底也顶不开它。
     ⚠️ 只改数值不改个数：`check-mp-tokens` 的棘轮数的是"裸写的处数"，
     这一行本来就是 3 处，改大不增不减。 */
  padding: 24rpx 24rpx calc(136rpx + env(safe-area-inset-bottom));
  /* 必须自带底色 + 铺满。
     为什么：深色变量挂在**根容器**的 class 上（.theme-dark），而 `page` 元素自己
     永远是浅色（浅色表写在 .page,page 上，那是默认态）。根容器不铺满、不画底色的话，
     深色下会从下边缘 / 短内容处透出那条浅色带 —— 看着像"深色没铺满"。
     min-height 而不是 height：内容不足一屏时底色也要到底。 */
  min-height: 100%;
  background: var(--td-bg-color-page);
  /* 正文色也必须在这里声明一次，**不能只靠继承 page 的 color**。
     为什么：CSS 自定义属性是"在声明它的元素上解析"——`page` 元素自己身上没有
     .theme-dark（那个 class 挂在本节点上），所以 `page { color: var(--td-text-color-primary) }`
     里的 var() 解析到的是**浅色表**的 #1f2329（近黑），算出的 color 作为**计算值**
     继承给所有后代。后代虽然重定义了 --td-text-color-primary，但 color 是继承来的
     计算值，不会因为变量变了而重算 —— 结果深色下凡是没显式写 color 的文字
     （主机名、会话标题、区块标题…）全是近黑字压在深底上，真机上"字全黑了"。
     在挂了 .theme-dark 的节点上重新声明一次，var() 才会在深色表的上下文里解析。 */
  color: var(--td-text-color-primary);
}

/* ── 页面环境光：浅色一层极淡冷调、深色两团极光（2026-10-09 / 10）──────
   浅色与深色**同一种做法、两套取值**：
   ① 不用加子节点 ⇒ 没有 z-index 打架（一个 absolutely 定位的视图要么盖住内容、
      要么被内容盖住，两种都要在别处补 `position: relative`）；
   ② `background-color` 保持是一个 `--td-*` 变量 ⇒ 对比度闸仍然读到真实的底色
      （`FG_ON` 那套解析靠的就是它）。⚠️ 而 `background-image` 对它是**不可见**的，
      所以渐变的对比度只能手工守 —— 理由与两端取值写在 gen-mp-theme.mjs 的
      `DARK_PAINT` / `LIGHT_PAINT` 注释里。
   ⚠️ `background-attachment: fixed`：让那层光不随内容滚走。
   不支持时这一条被**忽略**，退化成"锚在页面顶部的一团光" —— 仍然好看、不会破。
   ⚠️ 只挂 `.page-pad`（列表页）。聊天页是内层 scroll-view + 用户反复调过的
   composer，动它的底色风险远大于收益。 */
.page-pad {
  /* 浅色：顶部两团几乎看不见的品牌色 —— 目的是让"纯白页面"有一点空气感，
     而不是让人看见"这里有个渐变"。透明度 0.055~0.070，再高就开始显脏。 */
  background-image:
    radial-gradient(120% 56% at 8% -8%, var(--td-wash-brand) 0%, rgba(255, 255, 255, 0) 60%),
    radial-gradient(92% 48% at 96% 0%, var(--td-wash-violet) 0%, rgba(255, 255, 255, 0) 56%);
  background-repeat: no-repeat;
  background-attachment: fixed;
}

.page-pad.theme-dark {
  background-image:
    radial-gradient(130% 62% at 10% -10%, var(--td-aurora-indigo) 0%, rgba(0, 0, 0, 0) 62%),
    radial-gradient(96% 52% at 94% 0%, var(--td-aurora-cyan) 0%, rgba(0, 0, 0, 0) 58%);
  background-repeat: no-repeat;
  background-attachment: fixed;
}

/* ── 卡片：三页共用的基础容器 ─────────────────────────────────────────
   统一圆角与描边。**白底 + 描边是底色层次的主力**：真机上投影在小屏里会糊成
   一片，描边在浅/深色两种主题下都干净。

   ⚠️ 2026-10-10 浅色加了**一层很轻的投影**（改动说明，不是推翻上面那条）：
   页面底从 `#f3f3f3` 换成更冷的 `#eff2f7` 之后，白卡片与页面底的明度差没有变，
   但**描边被一起换成了冷灰**、对比更低，于是"卡片是一张卡"这件事少了一点提示。
   加的是 `0 2rpx 10rpx` 这个量级 —— 它不构成"投影"，只是在卡片下沿垫一层
   几乎看不见的暗，把轮廓补回来。深色那侧不加这个（那边靠 inset 高光 + 大投影）。 */
.card {
  background: var(--td-bg-color-container, #ffffff);
  border: 2rpx solid var(--td-component-border, #e7e7e7);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx 0 rgba(29, 42, 74, 0.055);
}

/* ── 深色专属：卡片"浮起来"（2026-10-09）───────────────────────────────
   新色阶把描边压暗了（TDesign 深色的 #5e5e5e 是给浅底用的，深底上整屏发灰），
   层次就得靠这两道光找回来：
     · `inset` 顶边那一线 —— 卡片像是被上方光源照到，是"浮起"的**主要**线索；
     · 外投影 —— 把它从页面底上托开。
   ⚠️ 用 inset 而不是 `::before`：`.card` 有 `overflow: hidden`，伪元素还得
   自己复刻一遍圆角（否则两端露直角），而 inset 阴影自动跟随 border-radius。 */
.theme-dark .card {
  box-shadow:
    inset 0 2rpx 0rpx 0 var(--td-card-sheen),
    0 12rpx 32rpx 0 rgba(0, 0, 0, 0.45);
}

/* 区块标题：不算内容，只是标签 */
.section-title {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #5c6470);
  padding: 24rpx 16rpx 12rpx;
}

/* ── 分区标题前面的一道品牌色标记（2026-10-09 深色 / 10-10 扩到两个主题）──
   光有一行灰字时，分区标题和正文是同一种东西；加一根品牌色短竖条，
   分区就成了**结构**而不只是标签。
   ⚠️ 2026-10-10 从「深色专属」改成两主题共用：浅色下它同样成立
   （品牌渐变在浅底上一样看得清），而且浅色是**默认**主题 —— 只给深色加，
   等于大多数用户看不到这个设计。渐变两端对浅底的对比度见 LIGHT_PAINT 注释。
   ⚠️ `padding-left` 必须走 token：`check-mp-tokens` 的棘轮把裸写 rpx 记在
   padding / margin / gap / border-radius / font-size 五类上，多一处就红。 */
.section-title {
  position: relative;
  padding-left: var(--drc-space-3);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 10rpx;
  /* 垂直居中用 calc 一句算完，而不是「top 定一半再往上顶一半」：
     后者要写在 margin 上，而 `margin` 在判据 ④ 的棘轮名单里（裸写 rpx 只许减
     不许增），负值在 `theme/tokens.mjs` 里又没有对应 token。与其去抬基线，
     不如换个写法 —— `top` / `left` / `width` / `height` 不在那份名单里。
     ⚠️ 这条注释本身也别写出「属性名 + 负数字面量」的相邻形状：判据 ④ **不剥注释**，
     那串字面量会被当成真声明记进棘轮（2026-10-09 实测：一句解释多算两处）。 */
  top: calc(50% - 12rpx);
  width: 4rpx;
  height: 24rpx;
  border-radius: var(--drc-radius-pill);
  background: var(--td-brand-gradient);
  opacity: 0.85;
}

/* 单行可省略文本：会话标题、路径这类长度不可控的内容 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  min-width: 0;
}

.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  word-break: break-all;
}

/* 弱化的辅助文字 */
.muted {
  color: var(--td-text-color-secondary, #5c6470);
  font-size: 24rpx;
  line-height: 36rpx;
}

/* 可点区域的统一按压反馈（view 用 hover-class="pressed"）。
   小程序没有 :active，不显式声明的话点下去毫无反馈。 */
.pressed {
  opacity: 0.55;
}

/* ── 语义色：状态圆点与胶囊标签，sessions / pair 两页共用 ───────────
   这两组颜色到处都要用（在线/连接中/异常/待办），散在各页写就会漂。 */
.dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--td-text-color-placeholder, #a0a6b0);
}

.dot.success {
  background: var(--td-success-color, #2ba471);
  /* ── 浅色：状态灯外面一圈更深的**同色环**（2026-10-10）──────────────
     深色那侧用"发光"（半透明加亮），浅色这侧**必须反过来**：
     在白底上加亮等于没加，只会糊成一团脏色。所以这里用一圈比点自身
     略深、透明度 0.16 的实色环 —— 它把点和底隔开，读起来仍然是"一颗灯"。
     ⚠️ 深色那侧靠 `.theme-dark .dot.success`（多一个类，特异性更高）覆盖，
     所以这两套**不需要**顺序约定，改哪一段都不会互相踩。 */
  box-shadow: 0 0 0 4rpx var(--td-ring-success);
}

.dot.primary {
  background: var(--td-brand-color, #0052d9);
  box-shadow: 0 0 0 4rpx var(--td-ring-brand);
}

.dot.warning {
  background: var(--td-warning-color, #e37318);
  box-shadow: 0 0 0 4rpx var(--td-ring-warning);
}

.dot.danger {
  background: var(--td-error-color, #d54941);
  box-shadow: 0 0 0 4rpx var(--td-ring-danger);
}

.dot.blink { animation: dot-blink 1.1s ease-in-out infinite; }

/* ── 深色专属：状态灯带辉光（2026-10-09）────────────────────────────────
   "这一台现在通不通"是这一页唯一必须一眼看到的东西，而它在深色下只有一颗
   14rpx 的小点——深色底本来就吃掉细边缘，加一圈光才把它"托"出来。
   两层：`0 0 0 Npx` 是不透光环（把点和底隔开），`0 0 Npx Npx` 是外辉光。
   ⚠️ 辉光色**不从 `--td-*-color-6` 派生**：那些是"给字用的浅色值"，
   当辉光会亮得刺眼。各状态在 `gen-mp-theme.mjs` 的 DARK_PAINT 里各给一档。 */
.theme-dark .dot {
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.05);
}

.theme-dark .dot.success {
  box-shadow: 0 0 0 6rpx rgba(31, 214, 153, 0.10), 0 0 18rpx 2rpx var(--td-glow-success);
}

.theme-dark .dot.primary {
  box-shadow: 0 0 0 6rpx rgba(63, 91, 246, 0.12), 0 0 18rpx 2rpx var(--td-glow-brand);
}

.theme-dark .dot.warning {
  box-shadow: 0 0 0 6rpx rgba(240, 160, 90, 0.10), 0 0 18rpx 2rpx var(--td-glow-warning);
}

.theme-dark .dot.danger {
  box-shadow: 0 0 0 6rpx rgba(255, 138, 146, 0.10), 0 0 18rpx 2rpx var(--td-glow-danger);
}

.pill {
  flex: 0 0 auto;
  font-size: 22rpx;
  line-height: 34rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-secondary, #5c6470);
}

.pill.success {
  background: var(--td-success-color-1, #e3f9e9);
  color: var(--td-success-color-6, #008858);
}

.pill.primary {
  background: var(--td-brand-color-1, #f2f3ff);
  color: var(--td-brand-color-on-tint, #0052d9);
}

.pill.warning {
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--td-warning-color-6, #be5a00);
}

.pill.danger {
  background: var(--td-error-color-1, #fff0ed);
  color: var(--td-error-color-6, #d54941);
}

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.2; }
}

/* 底部文字链接：sessions / pair 两页共用 */
.footer-link {
  margin-top: 40rpx;
  text-align: center;
  color: var(--td-brand-color-on-tint, #0052d9);
  font-size: 26rpx;
  line-height: 44rpx;
  padding: 16rpx;
}
